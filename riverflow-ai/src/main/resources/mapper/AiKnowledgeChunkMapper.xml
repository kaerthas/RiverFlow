<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.riverflow.ai.knowledge.mapper.AiKnowledgeChunkMapper">

    <delete id="deleteByDocId">
        DELETE FROM wf_ai_knowledge_chunk WHERE doc_id = #{docId}
    </delete>

    <select id="selectByDocId" resultType="com.riverflow.ai.knowledge.entity.AiKnowledgeChunk">
        SELECT id, doc_id, chunk_index, content, token_length, metadata, create_time
        FROM wf_ai_knowledge_chunk
        WHERE doc_id = #{docId}
        ORDER BY chunk_index
    </select>

</mapper>
