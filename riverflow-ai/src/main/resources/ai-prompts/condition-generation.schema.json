{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["expression", "explanation", "variables"],
  "properties": {
    "expression": {
      "type": "string",
      "pattern": "^#\\{.*\\}$"
    },
    "explanation": {
      "type": "string"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
