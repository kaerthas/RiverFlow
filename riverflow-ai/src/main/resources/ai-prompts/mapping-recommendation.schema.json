{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["mappings"],
  "properties": {
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "type", "confidence"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "type": {"type": "string", "enum": ["var", "const"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "unmappedTargets": {
      "type": "array",
      "items": {"type": "string"}
    },
    "unmappedSources": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
