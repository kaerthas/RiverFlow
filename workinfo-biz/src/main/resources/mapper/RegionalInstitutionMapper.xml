<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.inspur.workinfo.mapper.RegionalInstitutionMapper">

    <resultMap id="regionalInstitutionMap" type="com.inspur.workinfo.entity.RegionalInstitution">
        <id property="rid" column="RID"/>
        <result property="pid" column="PID"/>
        <result property="orgName" column="ORG_NAME"/>
        <result property="orgShortName" column="ORG_SHORT_NAME"/>
        <result property="orgCode" column="ORG_CODE"/>
    </resultMap>
</mapper>
