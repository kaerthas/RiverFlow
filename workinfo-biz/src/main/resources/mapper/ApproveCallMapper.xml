<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.inspur.workinfo.mapper.ApproveCallMapper">

  <resultMap id="approveCallMap" type="com.inspur.workinfo.entity.ApproveCall">
                  <id property="callId" column="CALL_ID"/>
                        <result property="bsnum" column="BSNUM"/>
                        <result property="callState" column="CALL_STATE"/>
                        <result property="callParameter" column="CALL_PARAMETER"/>
                        <result property="interfaceName" column="INTERFACE_NAME"/>
                        <result property="calledSystemCode" column="CALLED_SYSTEM_CODE"/>
                        <result property="calledSystemName" column="CALLED_SYSTEM_NAME"/>
                        <result property="calledSystemAddr" column="CALLED_SYSTEM_ADDR"/>
                        <result property="callTimes" column="CALL_TIMES"/>
                        <result property="callTime" column="CALL_TIME"/>
                        <result property="parameterValue" column="PARAMETER_VALUE"/>
            </resultMap>
</mapper>
